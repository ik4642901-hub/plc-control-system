    {
        "id": "cachestep",
        "type": "function",
        "z": "1665b10bb107a0a0",
        "name": "CACHE STEP",
        "func": "const step=Number(msg.payload)||0;\nconst prev=flow.get('step');\nif(step!==prev){flow.set('step',step);flow.set('stepAt',Date.now());\n if(step===1&&prev===3)flow.set('cycles',(flow.get('cycles')||0)+1);}\nreturn null;",
        "outputs": 0,
        "x": 500,
        "y": 60,
        "wires": []
    },
    {
        "id": "hstat",
        "type": "http in",
        "z": "1665b10bb107a0a0",
        "url": "/plc/status",
        "method": "get",
        "x": 520,
        "y": 360,
        "wires": [
            [
                "fstat"
            ]
        ]
    },
    {
        "id": "fstat",
        "type": "function",
        "z": "1665b10bb107a0a0",
        "name": "status",
        "func": "const s=flow.get('step')||0;\nmsg.headers={'Access-Control-Allow-Origin':'*','Cache-Control':'no-store'};\nmsg.payload={running:s>0,stage:s,relays:[s===1,s===2,s===3],stopHealthy:true,cycleCount:flow.get('cycles')||0,stageElapsedMs:Date.now()-(flow.get('stepAt')||Date.now()),stageMs:[10000,10000,10000]};\nreturn msg;",
        "outputs": 1,
        "x": 690,
        "y": 360,
        "wires": [
            [
                "rstat"
            ]
        ]
    },

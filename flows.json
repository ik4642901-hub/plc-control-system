    {
        "id": "f29103dd6f9ec6ee",
        "type": "function",
        "z": "1665b10bb107a0a0",
        "name": "Run-Timer",
        "func": "let activeStep = context.get('activeStep') || 0;\nlet startTime = context.get('startTime') || null;\n\n// Live_Step se dynamic step input update\nif (msg.topic === \"step\" || typeof msg.payload === 'number') {\n    if (msg.payload !== activeStep) {\n        activeStep = msg.payload; // Step 1, 2, ya 3\n        startTime = activeStep > 0 ? Date.now() : null;\n        context.set('activeStep', activeStep);\n        context.set('startTime', startTime);\n    }\n}\n\n// Seconds calculation\nlet runtimeSec = 0;\nif (startTime && activeStep > 0) {\n    runtimeSec = Math.floor((Date.now() - startTime) / 1000);\n}\n\n// 3 Outputs for Relay 1, 2, and 3\nreturn [\n    { payload: activeStep === 1 ? runtimeSec : 0 },\n    { payload: activeStep === 2 ? runtimeSec : 0 },\n    { payload: activeStep === 3 ? runtimeSec : 0 }\n];",
        "outputs": 3,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",

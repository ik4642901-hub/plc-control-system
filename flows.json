    {
        "id": "fcmd",
        "type": "function",
        "z": "1665b10bb107a0a0",
        "name": "command",
        "func": "let b = msg.payload;\nif (typeof b === 'string') { try { b = JSON.parse(b); } catch (e) { b = {}; } }\nconst k = (b || {}).kind;\nconst reply = { headers: { 'Access-Control-Allow-Origin': '*' }, payload: { ok: true }, res: msg.res, req: msg.req };\nif (k === 'start') return [{ payload: true }, null, reply];\nif (k === 'stop') return [null, { payload: true }, reply];\nreturn [null, null, reply];",
        "outputs": 3,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 160,
        "y": 360,
